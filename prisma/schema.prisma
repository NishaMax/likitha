generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique @default(cuid())
  displayName   String    @default("")
  bio           String?   @db.Text
  name          String?
  image         String?
  avatarUrl     String?   @db.Text
  emailVerified DateTime?
  passwordHash  String?
  profileComplete Boolean  @default(false)
  role          Role      @default(READER)
  tier          WriterTier @default(BRONZE)
  tierScore     Int       @default(0)
  followersCount Int      @default(0)
  likesReceived  Int      @default(0)
  readsCount     Int      @default(0)
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  readingProgress ReadingProgress[]
  works         Work[]

  @@index([role])
}

model Work {
  id            String            @id @default(cuid())
  authorId      String
  type          WorkType
  title         String
  description   String            @db.Text
  genre         String
  content       String?           @db.Text
  status        PublicationStatus @default(DRAFT)
  submittedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([authorId, status])
  @@index([type, status])
}

model Chapter {
  id          String            @id @default(cuid())
  workId      String
  chapterNo   Int
  title       String
  content     String            @db.Text
  status      PublicationStatus @default(DRAFT)
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, chapterNo])
  @@index([workId, status])
}

model ReadingProgress {
  id            String    @id @default(cuid())
  userId        String
  workId        String
  workType      WorkType
  chaptersRead  Int       @default(0)
  totalChapters Int?
  lastChapter   Int?
  completed     Boolean   @default(false)
  firstReadAt   DateTime  @default(now())
  lastReadAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, lastReadAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  READER
  WRITER
  ADMIN
}

enum WriterTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  FEATURED
}

enum WorkType {
  STORY
  POETRY
  SONG
}

enum PublicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}
